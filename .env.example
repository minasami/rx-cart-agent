# Leave everything empty to run the full demo in MOCK mode (no keys needed).
# AI: "mock" (default) or "gateway" (Vercel AI Gateway)
AI_PROVIDER=mock
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# PayPal: "mock" (default) or "sandbox". Sandbox only, never live.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Demo pharmacist PIN (server-side check before any order is created)
PHARMACIST_DEMO_PIN=
# Optional: HMAC secret (>= 32 chars) for capture approval tokens. If empty, a random
# per-process secret is used, which is fine locally but must be set for multi-instance deploys.
APPROVAL_TOKEN_SECRET=
