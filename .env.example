# Leave everything empty to run the full demo in MOCK mode (no keys needed).
# AI: "mock" (default), "google" (Gemini API, free key from https://aistudio.google.com/apikey)
# or "gateway" (Vercel AI Gateway, needs a card on the Vercel team)
AI_PROVIDER=mock
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
# Optional model override. Empty = provider default: google -> gemini-3.5-flash, gateway -> openai/gpt-4o-mini.
# Google ids are bare (e.g. gemini-3-flash-preview); gateway ids are prefixed (e.g. openai/gpt-4o-mini).
AI_MODEL=
# google only: models tried when AI_MODEL is out of free-tier quota or overloaded. Empty = gemini-3-flash-preview,gemini-3.5-flash-lite; none = off
AI_FALLBACK_MODELS=
# PayPal: "mock" (default) or "sandbox". Sandbox only, never live.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Origin PayPal redirects back to (<APP_BASE_URL>/return). Default: http://127.0.0.1:<PORT or 3000>
APP_BASE_URL=
# Demo pharmacist PIN (server-side check before any order is created)
PHARMACIST_DEMO_PIN=
# Optional: HMAC secret (>= 32 chars) for capture approval tokens. If empty, a random
# per-process secret is used, which is fine locally but must be set for multi-instance deploys.
APPROVAL_TOKEN_SECRET=
